[Unit]
Description=OpenVPN admin dashboard (hub)
After=network.target

[Service]
User=ovpndash
Group=ovpndash
WorkingDirectory=/opt/ovpn-dashboard
EnvironmentFile=/etc/ovpn-dashboard/config.env
ExecStart=/opt/ovpn-dashboard/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8080
Restart=on-failure
RestartSec=3
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/etc/ovpn-dashboard

[Install]
WantedBy=multi-user.target
